{
  "name": "act-of-state",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:oracle": "node --test tests/reference-simulation.test.mjs tests/news-feed.test.mjs tests/release-contract.test.mjs tests/public-release.test.mjs tests/load-metrics.test.mjs tests/reform-content.test.mjs tests/development-progress.test.mjs tests/population-calibration.test.mjs",
    "prebuild": "node scripts/release-contract.mjs --emit",
    "check:release": "node scripts/check-public-release.mjs",
    "progress": "node scripts/development-progress.mjs --json",
    "progress:check": "node scripts/development-progress.mjs --check",
    "progress:write": "node scripts/development-progress.mjs --write"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
